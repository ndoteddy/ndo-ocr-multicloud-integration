# HTTP port the API listens on
PORT=8000

# Comma-separated list of origins allowed to call this API from a browser
CORS_ORIGINS=http://localhost:4200

# Shared-secret API key clients must send as the `x-api-key` header.
# Generate one with: openssl rand -hex 32
API_KEY=replace-with-a-strong-random-key

# MongoDB Atlas connection string (OCR result store)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=dbnando_demo
MONGODB_COLLECTION=image_analysis_with_rekognition

# Kafka REST proxy endpoint the backend publishes new OCR jobs to, and the
# bearer token / API key it authenticates with
KAFKA_PRODUCER_URL=https://<your-kafka-rest-proxy>/topics/image_analysis_my
KAFKA_PRODUCER_AUTH=Bearer replace-with-kafka-token
